#include "app.h"
#include <commdlg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#define LOGMSG (WM_APP+1)
#define DONEMSG (WM_APP+2)
#define DATAMSG (WM_APP+3)
static HWND win,fields[16],logbox,plot,startbtn,limitbtn,scanbtn,trip;
static HANDLE worker;
static Config active;
static int closing;
static int found_count[2];static char found_port[2][32];
typedef struct{int leg;double a,v;} Data;
static Data data[MAX_POINTS];static int count;
static const wchar_t *labels[]={L"2700 串口",L"GS610 串口",L"起始电流 A",L"截止电流 A",L"步长 A",L"限压 V",L"每点保持 s",L"负向停止 V",L"正向停止 V",L"2700 波特率",L"610 波特率",L"610 结束符",L"610 流控",L"2700 NPLC",L"CSV 路径（空为自动）",L"2700 软件流控 0/1"};
static void ui_log(const char *s){char *copy=_strdup(s);if(!PostMessageW(win,LOGMSG,0,(LPARAM)copy))free(copy);}
static void ui_record(int leg,int p,double a,double v,double drive){Data *d=malloc(sizeof(*d));(void)p;(void)drive;if(d){d->leg=leg;d->a=a;d->v=v;if(!PostMessageW(win,DATAMSG,0,(LPARAM)d))free(d);}}
static DWORD WINAPI work(void *arg){int rc=run((const Config*)arg,ui_log,ui_record);PostMessageW(win,DONEMSG,rc,0);return 0;}
static void edit_value(int i,const char *s){SetWindowTextA(fields[i],s);}
static int read_config(void){char b[512],*e;double v;int i;defaults(&active);active.linear=1;for(i=0;i<16;i++){GetWindowTextA(fields[i],b,sizeof(b));if(i==0||i==1){if(strlen(b)>=32)return 0;strcpy(i?active.port610:active.port2700,b);}else if(i==11||i==12){if(i==11){if(strcmp(b,"LF")&&strcmp(b,"CR")&&strcmp(b,"CRLF"))return 0;strcpy(active.term610,b);}else{if(strcmp(b,"none")&&strcmp(b,"xon")&&strcmp(b,"rtscts"))return 0;strcpy(active.flow610,b);}}else if(i==14){if(strlen(b)>=MAX_PATH)return 0;strcpy(active.csv,b);}else{v=strtod(b,&e);if(e==b||*e||!isfinite(v))return 0;switch(i){case 2:active.start=v;break;case 3:active.stop=v;break;case 4:active.step=v;break;case 5:active.limit=v;break;case 6:active.period=v;break;case 7:active.lower=v;break;case 8:active.upper=v;break;case 9:case 10:if(v<300||v>1000000||v!=(int)v)return 0;if(i==9)active.baud2700=(int)v;else active.baud610=(int)v;break;case 13:active.nplc=v;break;case 15:if(v!=0&&v!=1)return 0;active.flow2700=(int)v;break;}}}active.round_trip=SendMessageW(trip,BM_GETCHECK,0,0)==BST_CHECKED;return 1;}
static LRESULT CALLBACK plotproc(HWND h,UINT m,WPARAM w,LPARAM l){if(m==WM_PAINT){PAINTSTRUCT ps;HDC dc=BeginPaint(h,&ps);RECT r;int i,j;double xmin=-.01,xmax=.01,ymin=-.01,ymax=.01;HPEN pens[2],old;GetClientRect(h,&r);FillRect(dc,&r,(HBRUSH)GetStockObject(WHITE_BRUSH));for(i=0;i<count;i++){if(data[i].a<xmin)xmin=data[i].a;if(data[i].a>xmax)xmax=data[i].a;if(data[i].v<ymin)ymin=data[i].v;if(data[i].v>ymax)ymax=data[i].v;}TextOutW(dc,10,5,L"I–V 曲线（蓝：去程；红：返程/正向极限）",25);MoveToEx(dc,45,30,NULL);LineTo(dc,45,r.bottom-25);LineTo(dc,r.right-10,r.bottom-25);pens[0]=CreatePen(PS_SOLID,2,RGB(25,95,210));pens[1]=CreatePen(PS_SOLID,2,RGB(210,60,40));old=SelectObject(dc,pens[0]);for(j=0;j<4;j++){int first=1;SelectObject(dc,pens[j%2]);for(i=0;i<count;i++)if(data[i].leg==j){int x=45+(int)((data[i].a-xmin)/(xmax-xmin)*(r.right-65));int y=r.bottom-25-(int)((data[i].v-ymin)/(ymax-ymin)*(r.bottom-65));if(first){MoveToEx(dc,x,y,NULL);first=0;}else LineTo(dc,x,y);Ellipse(dc,x-2,y-2,x+2,y+2);}}SelectObject(dc,old);DeleteObject(pens[0]);DeleteObject(pens[1]);{char b[128];snprintf(b,sizeof(b),"I: %.4g ... %.4g A    V: %.4g ... %.4g V",xmin,xmax,ymin,ymax);TextOutA(dc,55,r.bottom-20,b,(int)strlen(b));}EndPaint(h,&ps);return 0;}return DefWindowProcW(h,m,w,l);}
static LRESULT CALLBACK proc(HWND h,UINT m,WPARAM w,LPARAM l){int i;switch(m){case WM_CREATE:{const char *values[]={"COM3","COM4","-3.2","3.2","0.08","12","2","-2","2","9600","9600","LF","none","1","","0"};for(i=0;i<16;i++){int col=i/8,row=i%8;CreateWindowW(L"STATIC",labels[i],WS_CHILD|WS_VISIBLE,15+col*480,15+row*32,190,24,h,NULL,NULL,NULL);fields[i]=CreateWindowExW(WS_EX_CLIENTEDGE,L"EDIT",L"",WS_CHILD|WS_VISIBLE|WS_TABSTOP|ES_AUTOHSCROLL,210+col*480,12+row*32,265,25,h,(HMENU)(INT_PTR)(100+i),NULL,NULL);edit_value(i,values[i]);}trip=CreateWindowW(L"BUTTON",L"返程测试",WS_CHILD|WS_VISIBLE|BS_AUTOCHECKBOX,15,280,130,28,h,NULL,NULL,NULL);startbtn=CreateWindowW(L"BUTTON",L"开始 Linear 扫描",WS_CHILD|WS_VISIBLE,160,280,170,30,h,(HMENU)1,NULL,NULL);limitbtn=CreateWindowW(L"BUTTON",L"位移极限",WS_CHILD|WS_VISIBLE,340,280,130,30,h,(HMENU)2,NULL,NULL);scanbtn=CreateWindowW(L"BUTTON",L"扫描串口设备",WS_CHILD|WS_VISIBLE,480,280,140,30,h,(HMENU)3,NULL,NULL);CreateWindowW(L"BUTTON",L"停止并关闭输出",WS_CHILD|WS_VISIBLE,630,280,160,30,h,(HMENU)4,NULL,NULL);CreateWindowW(L"BUTTON",L"选择 CSV…",WS_CHILD|WS_VISIBLE,800,280,140,30,h,(HMENU)5,NULL,NULL);plot=CreateWindowW(L"IVPlot",L"",WS_CHILD|WS_VISIBLE|WS_BORDER,15,325,935,270,h,NULL,NULL,NULL);logbox=CreateWindowExW(WS_EX_CLIENTEDGE,L"EDIT",L"",WS_CHILD|WS_VISIBLE|WS_VSCROLL|ES_MULTILINE|ES_READONLY|ES_AUTOVSCROLL,15,605,935,180,h,NULL,NULL,NULL);return 0;}
 case WM_COMMAND: switch(LOWORD(w)){case 1:case 2:case 3:if(worker)return 0;if(!read_config()){MessageBoxW(h,L"请输入有效参数；结束符为 LF/CR/CRLF，流控为 none/xon/rtscts。",L"参数错误",MB_ICONERROR);return 0;}active.limits=LOWORD(w)==2;active.scan=LOWORD(w)==3;InterlockedExchange(&cancelled,0);count=0;memset(found_count,0,sizeof(found_count));InvalidateRect(plot,NULL,TRUE);EnableWindow(startbtn,FALSE);EnableWindow(limitbtn,FALSE);EnableWindow(scanbtn,FALSE);worker=CreateThread(NULL,0,work,&active,0,NULL);if(!worker)PostMessageW(h,DONEMSG,1,0);return 0;
 case 4:InterlockedExchange(&cancelled,1);return 0;
 case 5:{OPENFILENAMEA of={0};char file[MAX_PATH]="";of.lStructSize=sizeof(of);of.hwndOwner=h;of.lpstrFilter="CSV files\0*.csv\0\0";of.lpstrFile=file;of.nMaxFile=MAX_PATH;of.lpstrDefExt="csv";of.Flags=OFN_PATHMUSTEXIST|OFN_NOCHANGEDIR;if(GetSaveFileNameA(&of))edit_value(14,file);return 0;}}break;
 case LOGMSG:{char *s=(char*)l;int n=GetWindowTextLengthA(logbox);if(n>200000)SetWindowTextA(logbox,"");SendMessageA(logbox,EM_SETSEL,(WPARAM)-1,(LPARAM)-1);SendMessageA(logbox,EM_REPLACESEL,FALSE,(LPARAM)s);SendMessageA(logbox,EM_REPLACESEL,FALSE,(LPARAM)"\r\n");if(active.scan){char port[32],id[512],model[128];if(sscanf(s,"%31s | %511[^|]",port,id)==2){char *comma=strchr(id,',');if(comma&&sscanf(comma+1," %127[^,]",model)==1){int role=(!_stricmp(model,"2700")||!_stricmp(model,"MODEL 2700"))?0:(!_stricmp(model,"GS610")||!_stricmp(model,"765501"))?1:-1;if(role>=0){found_count[role]++;strcpy(found_port[role],port);}}}}if(!strncmp(s,"LIMITS ",7)){double a,b;char buf[64];if(sscanf(s+7,"%lf %lf",&a,&b)==2){snprintf(buf,sizeof(buf),"%.10g",a);edit_value(2,buf);snprintf(buf,sizeof(buf),"%.10g",b);edit_value(3,buf);edit_value(4,"0.08");}}free(s);return 0;}
 case DATAMSG:if(count<MAX_POINTS)data[count++]=*(Data*)l;free((void*)l);InvalidateRect(plot,NULL,TRUE);return 0;
 case DONEMSG:if(active.scan){for(i=0;i<2;i++)if(found_count[i]==1)edit_value(i,found_port[i]);}if(worker){CloseHandle(worker);worker=NULL;}EnableWindow(startbtn,TRUE);EnableWindow(limitbtn,TRUE);EnableWindow(scanbtn,TRUE);if(closing)DestroyWindow(h);return 0;
 case WM_CLOSE:if(worker){closing=1;InterlockedExchange(&cancelled,1);SetWindowTextW(h,L"正在停止并确认关闭输出…");return 0;}DestroyWindow(h);return 0;
 case WM_DESTROY:PostQuitMessage(0);return 0;}return DefWindowProcW(h,m,w,l);}
int gui(void){WNDCLASSW wc={0};MSG msg;HINSTANCE instance=GetModuleHandleW(NULL);wc.hInstance=instance;wc.hCursor=LoadCursor(NULL,IDC_ARROW);wc.hbrBackground=(HBRUSH)(COLOR_BTNFACE+1);wc.lpszClassName=L"IVPlot";wc.lpfnWndProc=plotproc;RegisterClassW(&wc);wc.lpszClassName=L"GS610C";wc.lpfnWndProc=proc;RegisterClassW(&wc);win=CreateWindowW(L"GS610C",L"GS610 电流输出 + Keithley 2700 前面板采集 — C",WS_OVERLAPPED|WS_CAPTION|WS_SYSMENU|WS_MINIMIZEBOX,CW_USEDEFAULT,CW_USEDEFAULT,985,840,NULL,NULL,instance,NULL);if(!win)return 1;ShowWindow(win,SW_SHOW);while(GetMessageW(&msg,NULL,0,0)>0){if(!IsDialogMessageW(win,&msg)){TranslateMessage(&msg);DispatchMessageW(&msg);}}return 0;}
